# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth (only shows "Continuar con Google" when set to true)
# Requires configuring Google provider credentials in Supabase Auth dashboard first.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Edition (evaluation, professional, enterprise, cloud)
MIA_EDITION=evaluation

# Demo mode: free messages per user/session before the paywall shows
# MIA_DEMO_FREE_MESSAGES=10

# WhatsApp / Meta Cloud (Frontline provider)
# Mock mode is ON by default when WHATSAPP_ACCESS_TOKEN is not set.
# WHATSAPP_MOCK=true forces mock; WHATSAPP_MOCK=false forces real delivery.
WHATSAPP_MOCK=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Bridge (Baileys) — dedicated service in services/whatsapp-bridge
# WHATSAPP_BRIDGE_URL=http://localhost:8787
# WHATSAPP_BRIDGE_SECRET=your_bridge_secret_here
