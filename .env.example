# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth (only shows "Continuar con Google" when set to true)
# Requires configuring Google provider credentials in Supabase Auth dashboard first.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (DEUDA TÉCNICA: obtener key en https://aistudio.google.com/apikey)
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Groq (DEUDA TÉCNICA: obtener key en https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# Edition (evaluation, professional, enterprise, cloud)
MIA_EDITION=evaluation

# Demo mode: free messages per user/session before the paywall shows
# MIA_DEMO_FREE_MESSAGES=10

# WhatsApp / Meta Cloud (Frontline provider)
# Mock mode is ON by default when WHATSAPP_ACCESS_TOKEN is not set.
# WHATSAPP_MOCK=true forces mock; WHATSAPP_MOCK=false forces real delivery.
WHATSAPP_MOCK=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Bridge (Baileys) — dedicated service in services/whatsapp-bridge
# WHATSAPP_BRIDGE_URL=http://localhost:8787
# WHATSAPP_BRIDGE_SECRET=your_bridge_secret_here

# Cron / Scheduled Jobs — shared secret for headless scheduler authentication
# Used by margin-audit and other scheduled endpoints (INV-DEPLOY-003)
# Generate: openssl rand -hex 32
# MIA_CRON_SECRET=your_cron_secret_here

# Platform JWT keys for per-tenant bridge auth (ADR-027)
# Generate: openssl genrsa 2048 | openssl rsa -pubout
# PLATFORM_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# PLATFORM_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Bridge also needs both keys for webhook signing (bridge-webhook audience).

# Super Admin — Platform owner user UUID (required for /dashboard/platform-admin)
# Get your UUID from Supabase Auth dashboard → Users
PLATFORM_OWNER_ID=
