# MIA WhatsApp Bridge — Environment

# Supabase (service role key, NEVER exposed to clients)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# MIA platform (Next.js) — where incoming WhatsApp messages are forwarded
MIA_APP_URL=http://localhost:3000

# Shared secret (legacy fallback during JWT migration — keep until all clients migrated)
# Must match WHATSAPP_BRIDGE_SECRET in the Next.js .env.local
WHATSAPP_BRIDGE_SECRET=change_me_shared_secret

# Platform JWT keys (ADR-027) — same pair as Next.js; bridge verifies API/WS and signs webhooks
# PLATFORM_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# PLATFORM_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Bridge HTTP + WebSocket server
BRIDGE_PORT=3001

# Defensive block: customer-facing texts and anti-spam windows
# BRIDGE_CALL_REJECT_TEXT=Hola! Por el volumen de mensajes que tengo no puedo contestar llamadas, escríbeme y con gusto te atenderé.
# BRIDGE_CALL_REJECT_COOLDOWN_MS=60000
# BRIDGE_AUDIO_FALLBACK_TEXT=No puedo escuchar notas de voz por aquí, escríbemelo por favor.
# BRIDGE_AUDIO_FALLBACK_COOLDOWN_MS=30000
# BRIDGE_AUDIO_WEBHOOK_TIMEOUT_MS=10000
