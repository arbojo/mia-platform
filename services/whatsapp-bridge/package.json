{
  "name": "mia-whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MIA WhatsApp Bridge — Baileys session manager for multi-tenant WhatsApp connections",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@supabase/supabase-js": "^2.45.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
