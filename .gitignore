# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# whatsapp bridge local logs (never committed)
services/whatsapp-bridge/*.log

# Bruno collection: only example/template environments are versioned.
# Any real local environment (values, session cookies, bridge secret) is ignored.
bruno/environments/
!bruno/environments/
!bruno/environments/*.example.bru
!bruno/environments/*.template.bru
bruno/.env

# env files (secrets are git-crypt encrypted; see .gitattributes)
.env
.env.*.local
!.env.example

# vercel
.vercel

# infra doctor report (generated artifact)
docs/doctor-report.md

# PRD generator output (generated artifacts)
docs/prd/

# IDE
.vscode/
.idea/

# Supabase
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
!.env.example
!.env.local
!services/whatsapp-bridge/.env
!services/whatsapp-bridge/.env.example

.invloop-drill/

# foreign agent loop artifacts
.loop-evidence/
